# .env.template
# Copy this file to .env and update with your values
# DO NOT commit .env to GitHub (it contains passwords)

# Database Configuration
DB_HOST=localhost
DB_PORT=5433
DB_NAME=learning_analytics
DB_USER=postgres
DB_PASSWORD=tool123

# Optional: PostgreSQL Connection String
# If you want to use a full connection string instead of individual parameters:
# DATABASE_URL=postgresql://postgres:tool123@localhost:5432/learning_analytics

# Optional: Backup Configuration
BACKUP_DIR=./backups
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM

# Optional: Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/application.log
